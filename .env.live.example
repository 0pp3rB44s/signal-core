# ============================================================================
# LIVE ENVIRONMENT TEMPLATE — copy to .env.live and fill in. NEVER COMMIT .env.live
# ============================================================================
# .env.live is gitignored. It does not exist in this repository and MUST NOT be
# created until the Live Pilot has been authorised in writing by the owner.
#
# Creating this file does NOT enable live trading. scripts/launch_live.sh
# additionally requires:
#   1. .env.live present and passing every guard assertion
#   2. state/LIVE_PILOT_AUTHORISATION present (owner-created, dated, signed)
#   3. the operator typing the confirmation phrase interactively
#   4. every Critical risk in docs/RISK_REGISTER.md resolved or accepted
# Four independent layers. No single variable can start live trading.
# ----------------------------------------------------------------------------

# --- MODE INVARIANTS (asserted by scripts/lib/env_guard.sh in live mode) ---
APP_ENV=production
APP_MODE=live
FORWARD_PAPER_ONLY=false            # INVARIANT: must be false in live mode
FORWARD_PAPER_ENABLED=true          # paper ledger still records alongside live
EXECUTION_ENABLED=true              # INVARIANT: must be true in live mode
EXECUTION_MODE=LIVE                 # INVARIANT: must be LIVE in live mode
POSITION_MANAGER_ENABLED=true
POSITION_LOOP_ENABLED=true
POSITION_SYNC_ON_START=true         # reconcile against exchange truth on start

# --- CREDENTIALS — supply at deploy time. NEVER commit real values. ---
# Requirements: trade permission ONLY, withdrawal DISABLED, IP allow-list set.
BITGET_API_KEY=__SET_AT_DEPLOY__
BITGET_API_SECRET=__SET_AT_DEPLOY__
BITGET_API_PASSPHRASE=__SET_AT_DEPLOY__

# --- MARKET SCOPE — pilot must start at the validated scope ---
WATCHLIST=LTCUSDT
MAX_SYMBOLS=1                       # pilot ceiling; RC1 validated 1
ALLOW_AUTO_WATCHLIST_REFRESH=false
BITGET_DEFAULT_GRANULARITY=15m
BITGET_CONFIRMATION_GRANULARITY=1h
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT

# --- SCAN LOOP ---
SCAN_ON_START=true
SCAN_LOOP_ENABLED=true
SCAN_INTERVAL_SEC=60

# --- RISK — pilot limits. Do not widen without a documented review. ---
MAX_OPEN_POSITIONS=1                # pilot ceiling
ACCOUNT_RISK_PER_TRADE_PCT=0.50
DEFAULT_LEVERAGE=3
MAX_LEVERAGE=3
MAX_DAILY_LOSS_PCT=1.0
HARD_DAILY_STOP_PCT=1.5
WEEKLY_FREEZE_LOSS_PCT=7.0
SYMBOL_COOLDOWN_MINUTES=30

# --- EXECUTION GATES — every one is an independent safety layer ---
EXECUTION_REQUIRE_CONFIRMATION=true # symbol allow-list enforced
EXECUTION_CONFIRM_SYMBOLS=LTCUSDT   # ONLY these symbols may be traded
EXECUTION_MAX_PER_CYCLE=1           # at most one order per scan
EXECUTION_PLAN_LIMIT=1
EXECUTION_MAX_LIVE_NOTIONAL_PER_TRADE_USDT=35
EXECUTION_MIN_LIVE_NOTIONAL_USDT=10

# --- SAFETY: smoke harness must never be enabled in live ---
FORWARD_PAPER_SMOKE_STRATEGY_ENABLED=false

# --- OPERATIONAL ---
LOG_LEVEL=INFO
FAST_LANE_ENABLED=false
DASHBOARD_ENABLED=false
PYTHONUNBUFFERED=1
