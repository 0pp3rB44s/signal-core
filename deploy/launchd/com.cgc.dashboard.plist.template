<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>com.cgc.dashboard</string>
 <key>ProgramArguments</key><array><string>/bin/bash</string><string>__PROJECT_DIR__/deploy/launchd/dashboard_agent.sh</string></array>
 <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
 <key>RunAtLoad</key><true/>
 <!-- The dashboard was the only cgc service without a restart policy. A single
      clean exit on 2026-08-27T08:55:01Z left it down for 15 hours because launchd
      had no instruction to bring it back. KeepAlive is unconditional here: unlike
      the engine, an always-up read-only dashboard has no state that makes a
      restart unsafe. ThrottleInterval stops a persistent failure hot-looping. -->
 <key>KeepAlive</key><true/>
 <key>ThrottleInterval</key><integer>30</integer>
 <key>StandardOutPath</key><string>__PROJECT_DIR__/logs/launchd_dashboard.out</string>
 <key>StandardErrorPath</key><string>__PROJECT_DIR__/logs/launchd_dashboard.err</string>
 <key>ProcessType</key><string>Background</string>
 <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string><!-- Authoritative production data root. When the dashboard runs from its own
      checkout this must point at the TRADING runtime, or every state read would
      resolve to the isolated checkout's empty state/ and the page would render a
      confident all-UNKNOWN dashboard indistinguishable from a dead bot. --><key>CGC_PROD_ROOT</key><string>__PROD_ROOT__</string></dict>
</dict></plist>
