<?xml version="1.0" encoding="UTF-8"?>
<!--
  60-second cadence for the LIVE watchdog (scripts/watchdog_live.sh).

  The watchdog is READ-ONLY: it observes and alerts, never restarts or steers
  anything. It holds its own non-blocking lock, so an overrunning run cannot be
  double-scheduled.

  Deliberately NOT KeepAlive: this is a periodic probe, not a daemon. A crashed
  run should be retried on the next interval, not respawned instantly.

  __PROJECT_DIR__ is substituted by the installer.
-->
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.cgc.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/watchdog_live.sh</string>
  </array>
  <key>WorkingDirectory</key>   <string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key>          <true/>
  <key>StartInterval</key>      <integer>60</integer>
  <key>StandardOutPath</key>    <string>__PROJECT_DIR__/logs/watchdog_live.out</string>
  <key>StandardErrorPath</key>  <string>__PROJECT_DIR__/logs/watchdog_live.err</string>
  <key>ProcessType</key>        <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>             <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
