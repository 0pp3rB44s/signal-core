# Alert delivery for scripts/lib/alert.sh — TEMPLATE, contains no secrets.
#
# To activate:
#   1. cp deploy/alerting.env.example state/alerting.env
#   2. fill in the values for ONE provider
#   3. chmod 600 state/alerting.env        <- the watchdog raises
#                                             ALERTING_PERMISSIONS otherwise
#   4. scripts/lib/alert.sh emits a test line; confirm it arrives
#
# state/alerting.env is gitignored and is never read by the trading engine —
# only by the watchdog and alert helper. Credentials are never logged: alert.sh
# interpolates them directly into the curl invocation and logs only the outcome.
#
# ALERT_PROVIDER selects exactly one of the implemented channels below.
# Supported values (scripts/lib/alert.sh:23-41): telegram | discord | email | none

# --- option 1: telegram (recommended) --------------------------------------
# Outbound HTTPS only, no inbound port, no third-party webhook URL to leak,
# and the bot token can be revoked from the Telegram app without touching this
# host. Create a bot via @BotFather, then send it one message and read
# chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates
#ALERT_PROVIDER=telegram
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# --- option 2: discord -----------------------------------------------------
# Simplest to set up, but the webhook URL is itself the credential: anyone who
# obtains it can post to the channel, and it cannot be scoped or rotated
# without creating a new one.
#ALERT_PROVIDER=discord
#DISCORD_WEBHOOK_URL=

# --- option 3: email -------------------------------------------------------
# Uses /usr/bin/mail, so it depends on a working local MTA. On stock macOS
# there is none configured, and delivery failures are silent — verify with a
# test alert before relying on it.
#ALERT_PROVIDER=email
#ALERT_EMAIL_TO=

# --- explicitly disabled ---------------------------------------------------
# ALERT_PROVIDER=none suppresses delivery but still leaves
# ALERTING_UNCONFIGURED raised, which is deliberate: a LIVE engine that can
# place orders should not run without a notification path.
