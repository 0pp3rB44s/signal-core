# ============================================================================
# FORWARD PAPER ENVIRONMENT — safe to commit. Contains NO credentials.
# ============================================================================
# Loaded ONLY by scripts/launch_forward.sh. That launcher refuses to run if any
# invariant below is violated, and it cannot start live execution: the guard
# asserts EXECUTION_ENABLED=false and FORWARD_PAPER_ONLY=true independently of
# what this file says, so editing this file cannot enable live trading.
#
# Every variable is documented. Values match the RC1-validated configuration.
# ----------------------------------------------------------------------------

# --- MODE INVARIANTS (asserted by scripts/lib/env_guard.sh) ---
APP_ENV=production                  # environment label used in logs
APP_MODE=forward_paper              # human-readable mode label
FORWARD_PAPER_ONLY=true             # INVARIANT: forces execution off in Settings
FORWARD_PAPER_ENABLED=true          # paper ledger active
EXECUTION_ENABLED=false             # INVARIANT: no orders possible
EXECUTION_MODE=DRY_RUN              # INVARIANT: never LIVE in this file
POSITION_MANAGER_ENABLED=false      # no live position management in paper
POSITION_LOOP_ENABLED=false
POSITION_SYNC_ON_START=false

# --- CREDENTIALS: intentionally blank. Forward paper uses PUBLIC endpoints only.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- MARKET SCOPE (RC1-validated: one symbol, one timeframe pair) ---
WATCHLIST=LTCUSDT                   # single symbol validated in RC1
MAX_SYMBOLS=1                       # INVARIANT for pilot: one symbol
ALLOW_AUTO_WATCHLIST_REFRESH=false  # watchlist may not change under the run
BITGET_DEFAULT_GRANULARITY=15m      # primary timeframe (lowercase internally)
BITGET_CONFIRMATION_GRANULARITY=1h  # confirmation timeframe -> sent as 1H
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT

# --- SCAN LOOP ---
SCAN_ON_START=true
SCAN_LOOP_ENABLED=true
SCAN_INTERVAL_SEC=60                # RC1 cadence: median 63 s observed

# --- RISK (unchanged from validated values; NOT tuned) ---
MAX_OPEN_POSITIONS=1                # INVARIANT for pilot: one position
ACCOUNT_RISK_PER_TRADE_PCT=0.50
DEFAULT_LEVERAGE=3
MAX_LEVERAGE=3
MAX_DAILY_LOSS_PCT=1.0
HARD_DAILY_STOP_PCT=1.5
WEEKLY_FREEZE_LOSS_PCT=7.0
SYMBOL_COOLDOWN_MINUTES=30

# --- FORWARD PAPER LEDGER ---
FORWARD_PAPER_ROUNDTRIP_FEE_BPS=12
FORWARD_PAPER_LIQUIDITY_ASSUMPTION=taker
TP1_CLOSE_PCT=100
TP2_CLOSE_PCT=0
TP3_CLOSE_PCT=0

# --- NON-PRODUCTION SMOKE HARNESS (must stay false outside lifecycle testing) ---
FORWARD_PAPER_SMOKE_STRATEGY_ENABLED=false

# --- OPERATIONAL ---
LOG_LEVEL=INFO
FAST_LANE_ENABLED=false
DASHBOARD_ENABLED=false
PYTHONUNBUFFERED=1
